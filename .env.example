# MailPilot AI — Environment Configuration Template
# Copy this file to .env and replace placeholder values.

# -----------------------------------------------------------------------------
# General Application Settings
# -----------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-secret-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL 16 / Neon Serverless Postgres)
# -----------------------------------------------------------------------------
# For Local Docker PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://mailpilot:mailpilot_dev_secret@localhost:5432/mailpilot_db
# SYNC_DATABASE_URL=postgresql://mailpilot:mailpilot_dev_secret@localhost:5432/mailpilot_db

# For Neon Serverless Postgres:
# Copy your connection string from the Neon console and use:
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<endpoint-id>.neon.tech/<dbname>?ssl=require
# SYNC_DATABASE_URL=postgresql://<user>:<password>@<endpoint-id>.neon.tech/<dbname>?sslmode=require

POSTGRES_USER=mailpilot
POSTGRES_PASSWORD=mailpilot_dev_secret
POSTGRES_DB=mailpilot_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=sqlite+aiosqlite:///./mailpilot_dev.db
SYNC_DATABASE_URL=sqlite:///./mailpilot_dev.db

# -----------------------------------------------------------------------------
# Token Encryption (AES-256-GCM / Fernet)
# Key must be a URL-safe base64-encoded 32-byte key.
# Generate in Python via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=dGhpcy1pcy1hLTMyLWJ5dGUtZW5jcnlwdGlvbi1rZXkxMjM=

# -----------------------------------------------------------------------------
# Application Authentication (Managed OIDC Provider - Auth0, Clerk, etc.)
# -----------------------------------------------------------------------------
OIDC_ISSUER=https://auth.mailpilot.local/
OIDC_AUDIENCE=mailpilot-api
OIDC_JWKS_URI=https://auth.mailpilot.local/.well-known/jwks.json
# Development / Local mock mode: set to true to allow dev mock tokens
ENABLE_DEV_MOCK_AUTH=true

# -----------------------------------------------------------------------------
# Google OAuth (Gmail Integration)
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials
# Redirect URI: http://localhost:8000/api/v1/oauth/google/callback
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/oauth/google/callback

# -----------------------------------------------------------------------------
# Microsoft OAuth (Outlook Integration)
# Create credentials in Microsoft Entra ID (Azure AD) App Registrations
# Redirect URI: http://localhost:8000/api/v1/oauth/microsoft/callback
# -----------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/oauth/microsoft/callback

# -----------------------------------------------------------------------------
# Frontend Application Settings (apps/web)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

