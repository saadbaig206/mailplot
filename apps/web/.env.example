# MailPilot AI Frontend — Environment Configuration
# Configure these in your Vercel Project Settings -> Environment Variables

# URL of your deployed FastAPI backend (e.g. https://api.mailpilot.ai or your cloud deployment)
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# Canonical URL of your Vercel deployment (e.g. https://mailpilot.ai or https://your-project.vercel.app)
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app

